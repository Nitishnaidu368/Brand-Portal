# Copy to .env.local. All of these values are server-only; never use NEXT_PUBLIC_ prefixes.
# Supabase Connect > Transaction pooler (port 6543), with URL-encoded password
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
# Supabase session pooler (5432) or direct connection, used only for release migrations
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=brand-portal
# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
SETUP_SECRET=
# Cannot exceed the free storage tier's 50 MiB object limit
MAX_UPLOAD_MB=50
# Production must stay 0. Set 1 only for a local HTTP production-mode smoke test.
INSECURE_COOKIES=0
